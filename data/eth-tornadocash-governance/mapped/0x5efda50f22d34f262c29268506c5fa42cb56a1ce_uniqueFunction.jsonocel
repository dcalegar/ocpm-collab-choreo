art::0xc8e68d674df0eab152926c4f0ee7d0ac0745c715", "qualifier": "source"}, {"objectId": "part::0x5efda50f22d34f262c29268506c5fa42cb56a1ce", "qualifier": "target"}, {"objectId": "cc::0xd80847db1cae69f854384318aaea478a4ab7006fc31279154ab01c9860859c70", "qualifier": "exchanged_in"}]}, {"id": "message::0xd80847db1cae69f854384318aaea478a4ab7006fc31279154ab01c9860859c70::req\\:0_1", "type": "Message", "attributes": [{"name": "caseId", "time": "1970-01-01T00:00:00Z", "value": "0xd80847db1cae69f854384318aaea478a4ab7006fc31279154ab01c9860859c70"}, {"name": "msgInstanceId", "time": "1970-01-01T00:00:00Z", "value": "req:0_1"}, {"name": "msgName", "time": "1970-01-01T00:00:00Z", "value": "propose call"}, {"name": "target", "time": "1970-01-01T00:00:00Z", "value": "77777FeDdddFfC19Ff86DB637967013e6C6A116C"}, {"name": "description", "time": "1970-01-01T00:00:00Z", "value": "{\"title\":\"Implement fee sharing model\",\"description\":\"Currently all rewards go to LPs, reducing utility value for token holders who are just getting diluted for nothing. \\n\\nSplit token rewards and fees 50/50 between LPs and token holders as per Curve Finance token model - rewards can optionally be time weighted to create velocity sinks, and incentivise long term thinking.\\n\\n\\n\\n\"}"}], "relationships": [{"objectId": "part::0x5efda50f22d34f262c29268506c5fa42cb56a1ce", "qualifier": "source"}, {"objectId": "part::0xffbac21a641dcfe4552920138d90f3638b3c9fba", "qualifier": "target"}, {"objectId": "cc::0xd80847db1cae69f854384318aaea478a4ab7006fc31279154ab01c9860859c70", "qualifier": "exchanged_in"}]}, {"id": "message::0xd80847db1cae69f854384318aaea478a4ab7006fc31279154ab01c9860859c70::res\\:0_1", "type": "Message", "attributes": [{"name": "caseId", "time": "1970-01-01T00:00:00Z", "value": "0xd80847db1cae69f854384318aaea478a4ab7006fc31279154ab01c9860859c70"}, {"name": "msgInstanceId", "time": "1970-01-01T00:00:00Z", "value": "res:0_1"}, {"name": "msgName", "time": "1970-01-01T00:00:00Z", "value": "propos